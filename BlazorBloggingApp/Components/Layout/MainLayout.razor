@inherits LayoutComponentBase
@inject NavigationManager Nav
@using BlazorBloggingApp.Services

<div class="page">
    <div class="sidebar">
        <div class="sidebar-brand px-3 py-3">
            <a class="text-white text-decoration-none fw-semibold" href="/">Blazor Blogging</a>
        </div>
        <div class="sidebar-content px-3 pb-3">
            @if (_posts is not null)
            {
                <PostList Posts="@_posts" OnPostSelected="HandlePostSelected" />
            }
        </div>
    </div>

    <main>
        <div class="top-row px-4">
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    [Inject] private IBlogApiClient Api { get; set; } = default!;

    private List<BlazorBloggingApp.Models.BlogPost>? _posts;

    protected override async Task OnInitializedAsync()
    {
        _posts = await Api.GetAllPostsAsync();
    }

    private void HandlePostSelected(Guid id) => Nav.NavigateTo($"/post/{id}");
}

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
