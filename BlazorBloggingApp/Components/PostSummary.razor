@* Navigation is a plain link so the summary works under static SSR and enhanced
   navigation — no event callback needs to cross a render-mode boundary. *@
<a class="post-summary card mb-2 text-decoration-none" href="@($"/post/{PostId}")">
    <div class="card-body">
        <h3 class="post-summary-title card-title h6 mb-1">@Title</h3>
        <p class="post-summary-excerpt card-text small text-body-secondary mb-0">@Excerpt</p>
    </div>
</a>

@code {
    [Parameter] public Guid PostId { get; set; }
    [Parameter] public string Title { get; set; } = default!;
    [Parameter] public string Excerpt { get; set; } = default!;
}
